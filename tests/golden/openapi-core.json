  "info": {
    "description": "REST API of FlowStat. Every route except `/health` needs `Authorization: Bearer <token>`; the role\nof the token decides what it may do (`x-permission` on each operation). Every error has the body\n`{\"errors\": [{\"code\", \"message\", \"field\"?, \"line\"?, \"column\"?}]}`.\n",
    "title": "FlowStat",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/catalogue/{list_name}": {
      "put": {
        "operationId": "put_catalogue_catalogue__list_name__put",
        "parameters": [
          {
            "in": "path",
            "name": "list_name",
            "required": true,
            "schema": {
              "title": "List Name",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CatalogueIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogueSaved"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "no valid token (E-AUTH-001)"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "the role lacks the permission (E-AUTH-002)"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "not found (E-API-002)"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "conflict with the state of the resource (E-API-003)"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "the request is invalid (E-API-001, E-API-004, E-API-005, E-INPUT-*)"
          }
        },
        "summary": "Replace a list of the reference catalogue",
        "tags": [
          "workflows"
        ],
        "x-permission": "catalogue:write"
      }
    },
